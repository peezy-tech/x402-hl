{
  "name": "x402-hl",
  "version": "0.2.1",
  "type": "module",
  "description": "Standalone Hyperliquid primitives and injected-wallet paywall for x402.",
  "license": "MIT",
  "author": "Peezy",
  "homepage": "https://github.com/peezy-tech/x402-hl#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peezy-tech/x402-hl.git"
  },
  "bugs": {
    "url": "https://github.com/peezy-tech/x402-hl/issues"
  },
  "keywords": [
    "x402",
    "hyperliquid",
    "payments",
    "paywall",
    "http-402"
  ],
  "scripts": {
    "audit:prod": "pnpm audit --prod --audit-level high",
    "build": "pnpm build:paywall && tsup",
    "build:paywall": "tsx src/paywall/build.ts",
    "compat:all": "pnpm compat:payment-identifier && pnpm compat:offer-receipt && pnpm compat:siwx && pnpm compat:intents && pnpm compat:mcp-axios",
    "compat:intents": "tsx examples/compat/intents.ts",
    "compat:mcp-axios": "tsx examples/compat/mcp-axios.ts",
    "compat:offer-receipt": "tsx examples/compat/offer-receipt.ts",
    "compat:payment-identifier": "tsx examples/compat/payment-identifier.ts",
    "compat:siwx": "tsx examples/compat/siwx.ts",
    "docs:build": "pnpm --dir docs build",
    "docs:check": "pnpm --dir docs check:types",
    "docs:dev": "pnpm --dir docs dev",
    "example:express:typecheck": "tsc -p examples/express/tsconfig.json",
    "pack:audit": "node scripts/pack-audit.mjs",
    "test": "tsx --test test/**/*.test.ts",
    "test:typecheck": "tsc -p tsconfig.tests.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.examples.json && tsc -p tsconfig.tests.json"
  },
  "dependencies": {
    "@nktkas/hyperliquid": "^0.33.2",
    "@x402/core": "^2.19.0",
    "valibot": "^1.4.2",
    "viem": "^2.55.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@craftamap/esbuild-plugin-html": "^0.9.0",
    "@tanstack/react-query": "^5.100.14",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@wagmi/connectors": "^5.11.2",
    "@x402/axios": "^2.19.0",
    "@x402/express": "^2.19.0",
    "@x402/extensions": "^2.19.0",
    "@x402/fetch": "^2.19.0",
    "@x402/paywall": "^2.19.0",
    "axios": "^1.18.0",
    "buffer": "^6.0.3",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "esbuild": "^0.25.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.4.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "wagmi": "^2.19.5"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./exact/client": {
      "import": {
        "types": "./dist/exact/client/index.d.ts",
        "default": "./dist/exact/client/index.js"
      }
    },
    "./exact/server": {
      "import": {
        "types": "./dist/exact/server/index.d.ts",
        "default": "./dist/exact/server/index.js"
      }
    },
    "./exact/facilitator": {
      "import": {
        "types": "./dist/exact/facilitator/index.d.ts",
        "default": "./dist/exact/facilitator/index.js"
      }
    },
    "./intents": {
      "import": {
        "types": "./dist/intents/index.d.ts",
        "default": "./dist/intents/index.js"
      }
    },
    "./intents/client": {
      "import": {
        "types": "./dist/intents/client/index.d.ts",
        "default": "./dist/intents/client/index.js"
      }
    },
    "./intents/server": {
      "import": {
        "types": "./dist/intents/server/index.d.ts",
        "default": "./dist/intents/server/index.js"
      }
    },
    "./paywall": {
      "import": {
        "types": "./dist/paywall/index.d.ts",
        "default": "./dist/paywall/index.js"
      }
    }
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "src/paywall/gen"
  ],
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24"
  }
}
